# =====================================
# .github/workflows/deploy-dev.yml
# =====================================

name: Deploy to Development

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  deploy_dev:
    name: Deploy to DEV environment
    runs-on: ubuntu-latest

    needs:
      - build-frontend
      - build-backend

    env:
      FRONT_TAG: ${{ needs.build-frontend.outputs.version }}
      #BACK_TAG: ${{ needs.build-backend.outputs.version }}
      ENV_NAME: development

    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Setup SSH
        uses: webfactory/ssh-agent@v0.9.0
        with:
          ssh-private-key: ${{ secrets.SSH_PRIVATE_KEY }}

      - name: Copy deploy script & execute remotely
        run: |
          ssh -o StrictHostKeyChecking=no ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }} << 'ENDSSH'
            echo "🔐 Deployment on DEV"
            cd /home/deployer/app

            echo "🎯 Updating docker-compose with version tags"
            sed -i "s|image: ghcr.io/.*/frontend-app:.*|image: ghcr.io/${{ github.repository_owner }}/frontend-app:${FRONT_TAG}|" docker-compose.override.yml
            sed -i "s|image: ghcr.io/.*/backend-api:.*|image: ghcr.io/${{ github.repository_owner }}/backend-api:${BACK_TAG}|" docker-compose.override.yml

            echo "🚀 Pulling images and restarting containers"
            docker-compose -f docker-compose.yml -f docker-compose.override.yml pull
            docker-compose -f docker-compose.yml -f docker-compose.override.yml up -d

            echo "✅ Deployment complete"
          ENDSSH
